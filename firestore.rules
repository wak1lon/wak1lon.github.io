rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSiteAdministrator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "wakilongestor@gmail.com";
    }

    match /siteSettings/public {
      allow read: if true;
      allow create, update, delete: if isSiteAdministrator();
    }

    match /siteAssets/{assetId} {
      allow read: if true;
      allow create, update: if isSiteAdministrator()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 820000;
      allow delete: if isSiteAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
